              "name": "Content",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 48,
              "children": [
                {
                  "type": "frame",
                  "id": "vRjOu",
                  "name": "tS1",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "hWiC4",
                      "name": "tS1H",
                      "fill": "#1B3A28",
                      "content": "1. Acceptance of Terms",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "iHcYi",
                      "name": "tS1P",
                      "fill": "#4A6B56",
                      "content": "By downloading, installing, or using Debt Payoff X (\"the App\"), you agree to be bound by these Terms of Service. If you do not agree to these terms, do not use the App.\n\nThese terms constitute a legal agreement between you and the developer of Debt Payoff X (\"we\", \"us\", \"our\"). These terms may be updated periodically; continued use of the App after updates constitutes acceptance.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "52QWd",
                  "name": "tS2",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "dS2m7",
                      "name": "tS2H",
                      "fill": "#1B3A28",
                      "content": "2. License to Use",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "AFvwg",
                      "name": "tS2P",
                      "fill": "#4A6B56",
                      "content": "We grant you a limited, non-exclusive, non-transferable, revocable license to use the App for your personal, non-commercial purposes, subject to these Terms.\n\nThis license does not include the right to: (a) resell or commercially exploit the App; (b) reverse engineer or derive source code; (c) copy or adapt the App's code; (d) remove proprietary notices.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "leRRS",
                  "name": "tS3",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "TyMKj",
                      "name": "tS3H",
                      "fill": "#1B3A28",
                      "content": "3. Permitted Use",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "o5W61",
                      "name": "tS3P",
                      "fill": "#4A6B56",
                      "content": "The App is designed for personal debt management and financial planning. You may:\n\n• Track personal debts, loans, and credit accounts\n• Set up Snowball or Avalanche payoff strategies\n• Log payments and view your debt-free timeline\n• Export your data to CSV for personal use\n• Create encrypted local backups",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "mRuoA",
                  "name": "tS4",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "yObTQ",
                      "name": "tS4H",
                      "fill": "#1B3A28",
                      "content": "4. Prohibited Use",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "3L4Qf",
                      "name": "tS4P",
                      "fill": "#4A6B56",
                      "content": "You agree not to use the App in any way that: (a) violates applicable laws; (b) infringes on intellectual property rights; (c) attempts to gain unauthorized access to other systems; (d) distributes malware or harmful code.\n\nThe App must not be used as a substitute for professional financial advice. All calculations are estimates for planning purposes only.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "3y0jx",
                      "name": "tWarningBox",
                      "width": "fill_container",
                      "fill": "#D97706",
                      "cornerRadius": 12,
                      "stroke": {
                        "thickness": 0,
                        "fill": "#D6DDD0"
                      },
                      "gap": 16,
                      "padding": [
                        20,
                        24
                      ],
                      "children": [
                        {
                          "type": "icon_font",
                          "id": "pDdii",
                          "name": "tWarnIcon",
                          "width": 20,
                          "height": 20,
                          "iconFontName": "triangle-alert",
                          "iconFontFamily": "lucide",
                          "fill": "#FFFFFF"
                        },
                        {
                          "type": "text",
                          "id": "r9rbT",
                          "name": "tWarnTxt",
                          "fill": "#FFFFFF",
                          "content": "Not Financial Advice: Debt Payoff X provides calculations and projections for planning purposes only. Consult a qualified financial advisor for personalized guidance.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 15,
                          "fontWeight": "500"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "PH5hJ",
                  "name": "tS5",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "AHCUX",
                      "name": "tS5H",
                      "fill": "#1B3A28",
                      "content": "5. In-App Purchases",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "rfyyR",
                      "name": "tS5P",
                      "fill": "#4A6B56",
                      "content": "The App may offer a one-time purchase to unlock premium features. All purchases are processed by Apple and subject to Apple's payment terms and refund policies. We do not store payment information.\n\nRefund requests must be submitted through Apple's standard refund process. We do not offer direct refunds outside of Apple's policies.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "rwWS0",
                  "name": "tS6",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "tSvZt",
                      "name": "tS6H",
                      "fill": "#1B3A28",
                      "content": "6. Disclaimer of Warranties",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "7yjNU",
                      "name": "tS6P",
                      "fill": "#4A6B56",
                      "content": "The App is provided \"as is\" without warranties of any kind, express or implied. We do not warrant that: (a) the App will be error-free; (b) calculations will be 100% accurate for all scenarios; (c) the App will be available at all times.\n\nFinancial calculations are based on standard amortization formulas and are approximations.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "vpBld",
                  "name": "tS7",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "7B3uw",
                      "name": "tS7H",
                      "fill": "#1B3A28",
                      "content": "7. Limitation of Liability",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "yJs0k",
                      "name": "tS7P",
                      "fill": "#4A6B56",
                      "content": "To the maximum extent permitted by law, we shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of the App, even if advised of the possibility of such damages.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
