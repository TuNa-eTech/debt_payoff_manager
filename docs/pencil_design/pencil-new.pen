            {
              "type": "frame",
              "id": "bR4JH",
              "name": "Content",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 48,
              "children": [
                {
                  "type": "frame",
                  "id": "36VYs",
                  "name": "pSection1",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "eVdGe",
                      "name": "pS1H",
                      "fill": "#1B3A28",
                      "content": "1. Overview",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "DajcS",
                      "name": "pS1P",
                      "fill": "#4A6B56",
                      "content": "Debt Payoff X (\"the App\") is committed to protecting your privacy. This Privacy Policy explains what information we collect, how we use it, and your rights regarding your data.\n\nThe App is designed as a local-first application. This means all your financial data — debts, payments, strategies — is stored entirely on your device and never transmitted to our servers.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "14APP",
                      "name": "pBox1",
                      "width": "fill_container",
                      "fill": "#1B3A2810",
                      "cornerRadius": 12,
                      "stroke": {
                        "thickness": 1,
                        "fill": "#D6DDD0"
                      },
                      "gap": 16,
                      "padding": [
                        20,
                        24
                      ],
                      "children": [
                        {
                          "type": "icon_font",
                          "id": "UimmA",
                          "name": "pBox1Icon",
                          "width": 20,
                          "height": 20,
                          "iconFontName": "shield-check",
                          "iconFontFamily": "lucide",
                          "fill": "#2D5E3A"
                        },
                        {
                          "type": "text",
                          "id": "ArWfj",
                          "name": "pBox1Txt",
                          "fill": "#1B3A28",
                          "content": "TL;DR: We don't collect, sell, or share your financial data. It stays on your device.",
                          "fontFamily": "Inter",
                          "fontSize": 15,
                          "fontWeight": "600"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "1xES8",
                  "name": "pSection2",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "gRPpN",
                      "name": "pS2H",
                      "fill": "#1B3A28",
                      "content": "2. Data We Collect",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "nukJA",
                      "name": "pS2P",
                      "fill": "#4A6B56",
                      "content": "We do not collect any personally identifiable information (PII). The following describes the minimal, anonymous technical data that may be involved:",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "vpXPR",
                      "name": "pS2List",
                      "layout": "vertical",
                      "gap": 12,
                      "padding": [
                        0,
                        8
                      ],
                      "children": [
                        {
                          "type": "frame",
                          "id": "Z1uen",
                          "name": "pS2L1",
                          "gap": 12,
                          "children": [
                            {
                              "type": "frame",
                              "id": "yUuXv",
                              "name": "pS2L1Dot",
                              "width": 6,
                              "height": 6,
                              "fill": "#2D5E3A",
                              "cornerRadius": 3
                            },
                            {
                              "type": "text",
                              "id": "hZRMJ",
                              "name": "pS2L1Txt",
                              "fill": "#4A6B56",
                              "content": "Crash reports (if you opt-in via iOS system settings) — anonymous, no financial data included.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "UkxAN",
                          "name": "pS2L2",
                          "gap": 12,
                          "children": [
                            {
                              "type": "frame",
                              "id": "6j2F3",
                              "name": "pS2L2Dot",
                              "width": 6,
                              "height": 6,
                              "fill": "#2D5E3A",
                              "cornerRadius": 3
                            },
                            {
                              "type": "text",
                              "id": "qxSo7",
                              "name": "pS2L2Txt",
                              "fill": "#4A6B56",
                              "content": "App Store purchase receipts — processed by Apple, not by us. We only verify entitlements locally.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "gc9ak",
                          "name": "pS2L3",
                          "gap": 12,
                          "children": [
                            {
                              "type": "frame",
                              "id": "F6Kc4",
                              "name": "pS2L3Dot",
                              "width": 6,
                              "height": 6,
                              "fill": "#2D5E3A",
                              "cornerRadius": 3
                            },
                            {
                              "type": "text",
                              "id": "HWZbd",
                              "name": "pS2L3Txt",
                              "fill": "#4A6B56",
                              "content": "No account creation required. No email, no name, no phone number is collected.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "iKTGr",
                  "name": "pSection3",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "ArNWS",
                      "name": "pS3H",
                      "fill": "#1B3A28",
                      "content": "3. How Data is Stored",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "eGSas",
                      "name": "pS3P",
                      "fill": "#4A6B56",
                      "content": "All user data (debts, payment logs, strategy preferences) is stored exclusively on your device using Apple's encrypted SQLite database (via iOS file system encryption). Data is protected by your device's passcode and Face ID/Touch ID when enabled.\n\nOptional iCloud backup: If you enable iCloud Drive on your device, your device may back up our local database as part of iOS system backup. This is managed entirely by Apple and subject to Apple's privacy policy.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "W8QDb",
                  "name": "pSection4",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "78u5y",
                      "name": "pS4H",
                      "fill": "#1B3A28",
                      "content": "4. Third-Party Services",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "CMdDX",
                      "name": "pS4P",
                      "fill": "#4A6B56",
                      "content": "Debt Payoff X does not integrate with any third-party analytics, advertising, or data collection services. The App does not include SDKs from Facebook, Google Analytics, Amplitude, Mixpanel, or similar platforms.\n\nThe only third-party interaction is with Apple's App Store for in-app purchase verification, which is governed by Apple's privacy policy.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "9Bs4g",
                  "name": "pSection5",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "eftZ0",
                      "name": "pS5H",
                      "fill": "#1B3A28",
                      "content": "5. Analytics & Tracking",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "8sZmz",
                      "name": "pS5P",
                      "fill": "#4A6B56",
                      "content": "We do not track you. We do not use cookies, pixels, or device fingerprinting. The App has no backend infrastructure that receives usage data. Our App Tracking Transparency (ATT) prompt will always reflect 'no tracking required.'",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "spKMv",
                  "name": "pSection6",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "TGxbi",
                      "name": "pS6H",
                      "fill": "#1B3A28",
                      "content": "6. Children's Privacy",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "9C8l9",
                      "name": "pS6P",
                      "fill": "#4A6B56",
                      "content": "Debt Payoff X is not directed to children under 13. We do not knowingly collect information from children. Since we collect no personal information from any users, no special handling applies.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "mp4ju",
                  "name": "pSection7",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "V5mhX",
                      "name": "pS7H",
                      "fill": "#1B3A28",
                      "content": "7. Changes to This Policy",
                      "fontFamily": "Newsreader",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "W0M5A",
                      "name": "pS7P",
                      "fill": "#4A6B56",
                      "content": "We may update this Privacy Policy from time to time. Any changes will be reflected on this page with an updated 'Last updated' date. Continued use of the App after changes constitutes acceptance of the updated policy.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "yw5QN",
                  "name": "pSection8",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
